{
  "name": "pisid3-lecture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "postinstall": "node scripts/apply-engine-patches.mjs",
    "engine:patch": "node scripts/apply-engine-patches.mjs",
    "engine:check": "node scripts/check-engine-patches.mjs",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "generate:content": "node scripts/generate-content.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:readiness": "node scripts/readiness.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts",
    "compile:access": "node scripts/compile-access-codes.mjs",
    "verify:certificate": "node scripts/verify-certificate.mjs",
    "build": "npm run engine:check && npm run validate:content && npm run compile:access && tsc --noEmit && vite build && node scripts/build-offline.mjs",
    "build:pages": "npm run build",
    "check:privacy": "node scripts/check-privacy.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:notes": "node scripts/check-notes-storage.mjs",
    "audit:content": "node scripts/review-content.mjs",
    "check:methodology": "node scripts/check-methodology.mjs",
    "check:generated": "node scripts/check-generated.mjs",
    "test:visuals": "node scripts/check-visuals.mjs"
  },
  "dependencies": {
    "@olgakraven/lecture-engine": "file:vendor/olgakraven-lecture-engine-0.2.0.tgz",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsqr": "^1.4.0",
    "oxlint": "^1.79.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
